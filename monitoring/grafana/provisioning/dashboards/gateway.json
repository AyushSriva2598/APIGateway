{
  "title": "Rate Limiter Gateway",
  "uid": "gateway-overview",
  "timezone": "browser",
  "refresh": "5s",
  "panels": [
    {
      "id": 1, "title": "Requests allowed vs rejected (rate/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum by (decision) (rate(gateway_rate_limit_decisions_total[1m]))", "legendFormat": "{{decision}}" }
      ]
    },
    {
      "id": 2, "title": "Rejection rate by algorithm",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum by (algorithm) (rate(gateway_rate_limit_decisions_total{decision=\"rejected\"}[1m]))", "legendFormat": "{{algorithm}}" }
      ]
    },
    {
      "id": 3, "title": "Rate limit check latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, algorithm) (rate(gateway_rate_limit_check_duration_seconds_bucket[5m])))", "legendFormat": "p50 {{algorithm}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, algorithm) (rate(gateway_rate_limit_check_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{algorithm}}" },
        { "expr": "histogram_quantile(0.99, sum by (le, algorithm) (rate(gateway_rate_limit_check_duration_seconds_bucket[5m])))", "legendFormat": "p99 {{algorithm}}" }
      ]
    },
    {
      "id": 4, "title": "Overall request rate (django_http)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(django_http_requests_total_by_method_total[1m]))", "legendFormat": "requests/s" }
      ]
    },
    {
      "id": 5, "title": "Total allowed vs rejected (last 5m)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum by (decision) (increase(gateway_rate_limit_decisions_total[5m]))", "legendFormat": "{{decision}}" }
      ]
    }
  ]
}